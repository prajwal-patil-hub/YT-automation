# Copy to .env (gitignored). Nothing here is needed for local rendering —
# only for the review gate and publishing.

# --- Telegram review gate ---------------------------------------------------
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (from @userinfobot). REQUIRED: without it the
# bot is a publish button for anyone who finds it. Comma-separate for several.
TELEGRAM_ALLOWED_USER_ID=
# Where review messages are sent. Defaults to the first allowed user id.
TELEGRAM_CHAT_ID=
# Optional: a self-hosted tdlib/telegram-bot-api server, which raises the bot
# upload cap from 50 MB to 2 GB. Leave blank to use the public API.
TELEGRAM_API_BASE=

# --- YouTube publishing -----------------------------------------------------
# From a Google Cloud OAuth "Desktop app" client. See docs/08.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtained once via the local auth flow, then reused forever.
YOUTUBE_REFRESH_TOKEN=
