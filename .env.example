# Copy to .env (gitignored). Nothing here is needed for local rendering —
# only for the review gate and publishing, which come in the next increment.

# Telegram review gate
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=        # your numeric user id — the bot must reject everyone else
TELEGRAM_API_BASE=               # e.g. http://localhost:8081 for a self-hosted Bot API server

# YouTube publishing
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_REFRESH_TOKEN=
